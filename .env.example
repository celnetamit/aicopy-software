# Core runtime
MANUSCRIPT_EDITOR_ENV=development
MANUSCRIPT_EDITOR_HOST=127.0.0.1
MANUSCRIPT_EDITOR_PORT=8000
PORT=8000
DATA_DIR=./data
DATABASE_URL=

# Auth
GOOGLE_CLIENT_ID=
ALLOWED_EMAIL_DOMAINS=celnet.in,conwiz.in,stmjournals.in,stmjournals.com,nanoschool.in,nstc.in
ADMIN_EMAILS=amit@conwiz.in,puneet.mehrotra@celnet.in
SESSION_TTL_HOURS=12

# Local manual login (development only)
MANUSCRIPT_EDITOR_LOCAL_LOGIN=0
MANUSCRIPT_EDITOR_LOCAL_LOGIN_USERNAME=admin
MANUSCRIPT_EDITOR_LOCAL_LOGIN_PASSWORD=change-this-password
MANUSCRIPT_EDITOR_DEV_TEST_TOKENS=0

# Security and request controls
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_UPLOAD_BYTES=10485760
MAX_TEXT_CHARS=500000
TASK_LIST_LIMIT_MAX=200
AUTH_RATE_LIMIT_COUNT=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
WRITE_RATE_LIMIT_COUNT=120
WRITE_RATE_LIMIT_WINDOW_SECONDS=300

# Processing
PROCESSING_JOB_WORKERS=2
FILE_RETENTION_DAYS=30
# Finished in-process jobs are dropped after this long (task_runs stays authoritative).
PROCESSING_JOB_RETENTION_SECONDS=900
PROCESSING_JOB_MAX_TRACKED=200
# Export variants generated during processing. The rest are built on first
# download. Set to "all" to restore eager generation of all four.
EXPORT_EAGER_MODES=clean
# SQLite only: how long a writer waits for the WAL lock before failing.
SQLITE_BUSY_TIMEOUT_MS=5000

# Error log
# Stored error rows are pruned after this many days by the retention sweep.
ERROR_LOG_RETENTION_DAYS=14
# Rotating JSON-lines copy at $DATA_DIR/logs/errors.log. Set 0 to disable.
ERROR_LOG_FILE_ENABLED=1
ERROR_LOG_MAX_BYTES=5242880
ERROR_LOG_BACKUP_COUNT=3
# Browser error beacon (POST /api/client-errors). Set 0 to disable.
CLIENT_ERROR_REPORTING_ENABLED=1
CLIENT_ERROR_RATE_LIMIT_COUNT=30
CLIENT_ERROR_RATE_LIMIT_WINDOW_SECONDS=300

# Concurrency
# Reference lookups (Crossref/OpenAlex/Serper) that may be in flight at once.
REFERENCE_LOOKUP_CONCURRENCY=6
ONLINE_VALIDATION_CACHE_MAX_ENTRIES=4000
# Section prompts in flight at once, by provider class.
AI_SECTION_CONCURRENCY_LOCAL=2
AI_SECTION_CONCURRENCY_HOSTED=4
AI_SECTION_CONCURRENCY_MAX=8

# AI sampling
# One temperature for every provider. Copyediting wants a low, reproducible
# value; the candidate risk-scorer rejects high-drift output as unsafe.
# Admins can override this per deployment in the admin panel.
AI_TEMPERATURE=0.1

# AI provider credentials.
# These are the primary source; a key saved through the admin UI overrides them.
# Non-admin requests can never supply a provider, model, host or key.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Manuscript Editor
AGENT_ROUTER_TOKEN=
SERPER_API_KEY=

# Ollama transport tuning
MANUSCRIPT_EDITOR_OLLAMA_GENERATE_TIMEOUT_SECONDS=60
MANUSCRIPT_EDITOR_OLLAMA_HEALTH_TIMEOUT_SECONDS=5
MANUSCRIPT_EDITOR_OLLAMA_RETRY_COUNT=0
MANUSCRIPT_EDITOR_OLLAMA_RETRY_BACKOFF_SECONDS=0
MANUSCRIPT_EDITOR_OLLAMA_FALLBACK_MODEL_RETRY=true
# Comma-separated hosts an admin may point the Ollama client at.
# Leave empty to allow any host (admin-controlled only). Set this in shared
# deployments to bound the blast radius of a misconfigured setting.
OLLAMA_HOST_ALLOWLIST=
